# Vercel + Supabase only. No separate worker-host variables exist in this project.
NODE_ENV=production
PUBLIC_BASE_URL=https://your-domain.example

# Supabase server-side credentials. Never expose the secret key to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
# Telegram
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_WEBHOOK_SECRET=letters_numbers_underscore_or_dash_only
OWNER_TELEGRAM_ID=REPLACE_ME

# Owner admin login
ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Protects Supabase Cron -> Vercel job calls and deployment setup endpoints.
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
DEPLOY_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET

# Paper-only safety. The application refuses to boot jobs if either value is unsafe.
ENABLE_LIVE_TRADING=false
PAPER_TRADING_ONLY=true
DEFAULT_PAPER_NOTIONAL_USD=20
MAX_OPEN_POSITIONS=3
MAX_DAILY_ENTRIES=20
MAX_DAILY_ENTRIES_PER_MINT=2

# Market/safety providers
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6
STRICT_DATA_GATE=true

# Strategy thresholds
SNIPER_MIN_SCORE=70
SCALP_MIN_SCORE=72
RIDE_MIN_SCORE=74
